---
import CoursePage from '../../../components/CoursePage.astro';
import CourseLayout from '../../../layouts/CourseLayout.astro';
import { buildCourseModel, getCourseRoot, loadSiteBundle, makePageOutline } from '../../../lib/m5-6-publication.mjs';
import { buildDiscoveryModel } from '../../../lib/m5-7-discovery.mjs';
import { makePageRelations } from '../../../lib/m5-7-relations.mjs';

export const prerender = true;

export async function getStaticPaths() {
  const bundle = await loadSiteBundle();
  return bundle.publication.content.map((entity: any) => ({
    params: { routeKey: entity.route_key, slug: entity.slug },
    props: { contentId: entity.content_id }
  }));
}

const { contentId } = Astro.props;
const bundle = await loadSiteBundle();
const model = buildCourseModel(bundle);
const context = model.context(contentId);
const outline = makePageOutline(bundle, context.entity);
const relations = makePageRelations(bundle, context.entity, { outline });
const courseRoot = getCourseRoot(bundle);
const searchModel = buildDiscoveryModel(bundle);
const currentSearchDocument = searchModel.byContentId.get(contentId);
---

<CourseLayout
  title={context.entity.title}
  description={context.entity.summary}
  canonicalPath={context.route}
  courseRootRoute={courseRoot.route}
  outline={outline}
  searchModel={searchModel}
  currentSearchDocument={currentSearchDocument}
>
  <CoursePage context={context} publication={bundle.publication} relations={relations} />
</CourseLayout>

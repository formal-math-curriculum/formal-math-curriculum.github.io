---
import GlobalSearch from '../components/GlobalSearch.astro';
import OutlineNavigator from '../components/OutlineNavigator.astro';
import PreferenceControls from '../components/PreferenceControls.astro';
import PreferenceProvider from '../components/PreferenceProvider.astro';
import { CONTENT_REVISION } from '../lib/m5-6-publication.mjs';
import '../styles/custom.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  courseRootRoute: string;
  outline?: unknown;
  searchModel: {
    documents: Array<Record<string, any>>;
    filters: Array<{ id: string; label: string; options: Array<{ value: string; label: string }> }>;
    ranking: Record<string, unknown>;
    fingerprint: string;
  };
  currentSearchDocument?: Record<string, any>;
}

const { title, description, canonicalPath, courseRootRoute, outline, searchModel, currentSearchDocument } = Astro.props;
const canonical = new URL(canonicalPath, 'https://formal-math-curriculum.github.io').href;
const pagefindMetadata = currentSearchDocument ? [
  ['title', currentSearchDocument.title],
  ['content-id', currentSearchDocument.contentId],
  ['content-kind', currentSearchDocument.kind],
  ['summary', currentSearchDocument.summary],
  ['identifiers', currentSearchDocument.identifiers.join('|')],
  ['aliases', currentSearchDocument.aliases.join('|')],
  ['search-text', currentSearchDocument.searchText],
  ['source-revision', currentSearchDocument.sourceRevision],
  ['discovery-fingerprint', searchModel.fingerprint]
] : [];
const pagefindFilters = currentSearchDocument ? [
  ['fmc-result-kind', 'learner-content'],
  ['content-kind', currentSearchDocument.kind],
  ['editorial-state', currentSearchDocument.editorialState],
  ['formal-state', currentSearchDocument.formalState],
  ['publication-state', currentSearchDocument.publicationState],
  ...currentSearchDocument.representations.map((value: string) => ['representation', value]),
  ['locale', currentSearchDocument.locale],
  ...currentSearchDocument.translationStates.map((value: string) => ['translation-state', value])
] : [];
---

<!doctype html>
<html lang="en" data-fmc-course-slice="p5-m5.7" data-fmc-search-fingerprint={searchModel.fingerprint}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Formal Mathematics Curriculum" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {pagefindMetadata.map(([name, value]) => <meta data-pagefind-meta={`${name}[content]`} content={value} />)}
    {pagefindFilters.map(([name, value]) => <meta data-pagefind-filter={`${name}[content]`} content={value} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <title>{title} · Formal Mathematics Curriculum</title>
    <PreferenceProvider />
  </head>
  <body>
    <a class="fmc-skip-link" href="#main-content">Skip to course content</a>
    <header class="fmc-site-header" data-pagefind-ignore="all">
      <a class="fmc-site-brand" href="/">
        <span aria-hidden="true">∀</span>
        <span>Formal Mathematics Curriculum</span>
      </a>
      <nav aria-label="Primary">
        <a href={courseRootRoute}>Course</a>
        <a href="/about/method/">Authority</a>
      </nav>
      <div class="fmc-site-actions">
        <GlobalSearch
          documentCount={searchModel.documents.length}
          filters={searchModel.filters}
          ranking={searchModel.ranking}
          fingerprint={searchModel.fingerprint}
        />
        <PreferenceControls />
      </div>
    </header>

    <div class:list={["fmc-course-shell", { "fmc-course-shell--without-outline": !outline }]}>
      {outline ? (
        <aside class="fmc-course-outline" aria-label="Course and formal navigation" data-pagefind-ignore="all">
          <OutlineNavigator manifest={outline} heading="Explore this slice" />
          <p class="fmc-outline-help">
            Use Content kind to isolate Exercise, or select Module and Unit together. Menu search and
            Expand all / Collapse all operate only on this outline.
          </p>
        </aside>
      ) : null}
      <main id="main-content" class="fmc-course-main" data-pagefind-body>
        {currentSearchDocument ? (
          <span class="fmc-search-index-copy" aria-hidden="true" data-pagefind-weight="5">
            {currentSearchDocument.searchText}
          </span>
        ) : null}
        <slot />
      </main>
    </div>

    <footer class="fmc-site-footer" data-pagefind-ignore="all">
      <p>
        Representative partial corpus · English current · Portuguese unavailable · static/no backend.
      </p>
      <p>
        Content authority <code>P5-M5.6-CONTENT-v1</code> at
        <a href={`https://github.com/formal-math-curriculum/content/commit/${CONTENT_REVISION}`}><code>{CONTENT_REVISION.slice(0, 8)}…</code></a>.
      </p>
    </footer>
  </body>
</html>

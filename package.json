{
  "name": "formal-math-curriculum.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && node scripts/validate-boundaries.mjs",
    "test": "node --test tests/*.test.mjs",
    "ingest": "node scripts/ingest-content.mjs",
    "build:astro": "astro build",
    "test:browser": "node scripts/validate-m5-5-browser.mjs",
    "build:search": "pagefind --site dist",
    "validate:m5-6-artifact": "node scripts/validate-m5-6-artifact.mjs",
    "verify:artifact": "node scripts/verify-artifact.mjs",
    "build": "pnpm run check && pnpm run test && pnpm run ingest && pnpm run build:astro && pnpm run test:browser && pnpm run build:search && pnpm run validate:m5-6-artifact && pnpm run verify:artifact"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.7",
    "astro": "7.2.4",
    "pagefind": "1.5.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "playwright-core": "1.62.1",
    "typescript": "6.0.3",
    "yaml": "2.9.0"
  }
}

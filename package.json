{
  "name": "formal-math-curriculum.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check && node scripts/validate-boundaries.mjs",
    "test": "node --test tests/*.test.mjs",
    "ingest": "node scripts/ingest-content.mjs",
    "build:astro": "node scripts/clean-build-output.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "test:browser": "node scripts/validate-m5-5-browser.mjs",
    "test:m5-6-browser": "node scripts/validate-m5-6-browser.mjs",
    "test:m5-7-browser": "node scripts/validate-m5-7-search-browser.mjs",
    "test:m5-7-relations-browser": "node scripts/validate-m5-7-relations-browser.mjs",
    "build:m5-7-scale": "node scripts/build-m5-7-scale-artifacts.mjs",
    "licenses:generate": "node scripts/generate-license-inventory.mjs",
    "licenses:check": "node scripts/generate-license-inventory.mjs --check",
    "validate:m5-8-operations": "node scripts/validate-m5-8-operations.mjs",
    "test:m5-7-remediation-baseline": "FMC_M57_REMEDIATION_PASS=baseline node scripts/validate-m5-7-remediation-browser.mjs",
    "test:m5-7-remediation-final": "FMC_M57_REMEDIATION_PASS=final node scripts/validate-m5-7-remediation-browser.mjs",
    "build:search": "node scripts/build-search.mjs",
    "validate:m5-7-artifact": "node scripts/validate-m5-7-search-artifact.mjs",
    "validate:m5-7-relations-artifact": "node scripts/validate-m5-7-relations-artifact.mjs",
    "validate:m5-7-scale-artifact": "node scripts/validate-m5-7-scale-artifact.mjs",
    "validate:m5-6-artifact": "node scripts/validate-m5-6-artifact.mjs",
    "validate:m5-7-candidate-v1": "node scripts/validate-m5-7-integrated-candidate.mjs",
    "validate:m5-7-candidate": "node scripts/validate-m5-7-remediated-candidate.mjs",
    "verify:artifact": "node scripts/verify-artifact.mjs",
    "build": "pnpm run licenses:check && pnpm run validate:m5-8-operations && pnpm run check && pnpm run test && pnpm run ingest && pnpm run build:astro && pnpm run test:browser && pnpm run build:search && pnpm run test:m5-7-browser && pnpm run test:m5-7-relations-browser && pnpm run test:m5-6-browser && pnpm run build:m5-7-scale && pnpm run test:m5-7-remediation-baseline && pnpm run build:search && pnpm run test:m5-7-remediation-final && pnpm run validate:m5-7-artifact && pnpm run validate:m5-7-relations-artifact && pnpm run validate:m5-7-scale-artifact && pnpm run validate:m5-6-artifact && pnpm run validate:m5-7-candidate && pnpm run verify:artifact"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/starlight": "0.41.7",
    "astro": "7.2.4",
    "pagefind": "1.5.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "playwright-core": "1.62.1",
    "typescript": "6.0.3",
    "yaml": "2.9.0"
  }
}
